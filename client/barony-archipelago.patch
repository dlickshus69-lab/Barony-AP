@@ -0,0 +1,1623 @@
+// Barony Archipelago tracker window.
+//
+// Barony (the Archipelago build) starts this with the game, and writes
+// archipelago/tracker.txt about once a second. This window connects you (server, port and
+// name go in archipelago/connect.txt, which the game reads), then shows that file:
+// floor, what's left on the floor, lives, keys, deaths and the item log.
+
+#define NOMINMAX
+#include <sstream>
+#include <iterator>
+#include <windows.h>
+#include <algorithm>
+namespace Gdiplus { using std::min; using std::max; } // gdiplus.h needs these without the macros
+#include <objidl.h>
+#include <gdiplus.h>
+
+#include <algorithm>
+#include <fstream>
+#include <map>
+#include <winhttp.h>
+#include <atomic>
+#include <thread>
+#include <cmath>
+#include <cstring>
+#include <cwctype>
+#include <string>
+#include <vector>
+
+namespace
+{
+	struct TrackerState
+	{
+		std::map<std::string, std::string> values;
+		std::vector<std::string> items;
+		std::vector<std::string> log;
+		std::vector<std::pair<std::string, int>> deaths;
+		struct Spell { std::string name; char school; int copies; bool fromClass; bool read; };
+		std::vector<Spell> spells;
+		bool fileFound = false;
+	};
+
+	TrackerState g_state;
+	int g_tab = 0;              // bottom of the column: 0 item log, 1 full log, 2 spells
+	RECT g_tabRects[3] = {};
+	int g_sideScroll = 0;       // the right-hand column scrolls on its own (the map stays put)
+	int g_sideContentH = 0;
+	bool g_lootShort = false;   // the "other loot" box: full list (default) or just the total
+	int g_lastLootToggle = -1;  // F4 presses counted by the game
+	RECT g_lootBox{};           // where the loot box was drawn, for clicks
+	const COLORREF STEEL = RGB(184, 196, 214);
+	// The connect form: shown until the game says it's connected.
+	HWND g_main = nullptr, g_editServer = nullptr, g_editPort = nullptr, g_editName = nullptr, g_btnConnect = nullptr;
+	bool g_formShown = false;
+	int g_formTop = -1;
+	int g_sideX = 0;            // where the right-hand column starts (the map is left of it)
+	std::string g_roomLink;                  // the link typed in the Server box, if any
+	std::string g_pendingName;               // name to connect with once the port is found
+	bool g_pendingAuto = false;              // a lookup started by auto-reconnect
+	std::atomic<bool> g_lookupBusy{ false };
+	std::string g_lookupHost;                // written by the lookup thread before it posts
+	ULONGLONG g_lastLookup = 0;
+	int g_currentPort = 0;
+	const UINT WM_ROOM_PORT = WM_APP + 1;
+	std::wstring g_formNote;     // "enter a port", etc.
+	HBRUSH g_editBrush = nullptr;
+	const int ID_CONNECT = 101;
+	const int ID_PLAIN = 102;
+	HWND g_btnPlain = nullptr;
+	bool g_launcher = false;          // opened by barony.exe before the game starts: choose how to play
+	ULONGLONG g_gameStartedAt = 0;    // when Connect & Play let the game start
+	HFONT g_titleFont = nullptr, g_bodyFont = nullptr;
+	// Barony's own art, read from the Barony folder this program sits in.
+	Gdiplus::Image* g_logo = nullptr;
+
+	Gdiplus::Image* loadImage(const std::string& relative);
+
+	const COLORREF BG = RGB(22, 18, 14);
+	const COLORREF PANEL = RGB(38, 31, 24);
+	const COLORREF GOLD = RGB(255, 200, 90);
+	const COLORREF TEXT = RGB(225, 220, 210);
+	const COLORREF DIM = RGB(150, 145, 135);
+	const COLORREF GOOD = RGB(120, 230, 120);
+	const COLORREF BAD = RGB(240, 90, 80);
+
+	std::wstring widen(const std::string& s)
+	{
+		if ( s.empty() ) { return L""; }
+		int n = MultiByteToWideChar(CP_UTF8, 0, s.c_str(), (int)s.size(), nullptr, 0);
+		std::wstring w(n, L'\0');
+		MultiByteToWideChar(CP_UTF8, 0, s.c_str(), (int)s.size(), &w[0], n);
+		return w;
+	}
+
+	std::string exeDir()
+	{
+		char path[MAX_PATH] = {};
+		GetModuleFileNameA(nullptr, path, MAX_PATH);
+		std::string p = path;
+		size_t slash = p.find_last_of("\\/");
+		return slash == std::string::npos ? std::string(".") : p.substr(0, slash);
+	}
+
+	void readState()
+	{
+		TrackerState st;
+		std::ifstream in(exeDir() + "\\archipelago\\tracker.txt");
+		if ( in )
+		{
+			st.fileFound = true;
+			std::string line;
+			while ( std::getline(in, line) )
+			{
+				if ( !line.empty() && line.back() == '\r' ) { line.pop_back(); }
+				size_t eq = line.find('=');
+				if ( eq == std::string::npos ) { continue; }
+				std::string k = line.substr(0, eq), v = line.substr(eq + 1);
+				if ( k == "item" ) { st.items.push_back(v); st.log.push_back(v); }
+				else if ( k == "spell" )
+				{
+					std::vector<std::string> f;
+					size_t a = 0;
+					while ( true ) { size_t t = v.find('\t', a); f.push_back(v.substr(a, t == std::string::npos ? std::string::npos : t - a)); if ( t == std::string::npos ) { break; } a = t + 1; }
+					if ( f.size() >= 5 )
+					{
+						st.spells.push_back(TrackerState::Spell{ f[0], f[1].empty() ? 'S' : f[1][0], atoi(f[2].c_str()), f[3] == "1", f[4] == "1" });
+					}
+				}
+				else if ( k == "log" ) { st.log.push_back(v); }
+				else if ( k == "death" )
+				{
+					size_t tab = v.find('\t');
+					if ( tab != std::string::npos ) { st.deaths.emplace_back(v.substr(0, tab), atoi(v.c_str() + tab + 1)); }
+				}
+				else { st.values[k] = v; }
+			}
+		}
+		// A file caught half-written (no status line yet): keep what we had.
+		if ( st.fileFound && !st.values.count("connected") && g_state.fileFound ) { return; }
+		g_state = st;
+		// F4 in the game flips the loot box between full and short.
+		auto t = g_state.values.find("loot_toggle");
+		if ( t != g_state.values.end() )
+		{
+			int v = atoi(t->second.c_str());
+			if ( g_lastLootToggle >= 0 && v != g_lastLootToggle ) { g_lootShort = !g_lootShort; }
+			g_lastLootToggle = v;
+		}
+	}
+
+	Gdiplus::Image* loadImage(const std::string& relative)
+	{
+		std::string path = exeDir() + "\\" + relative;
+		std::wstring wpath(path.begin(), path.end());
+		Gdiplus::Image* img = Gdiplus::Image::FromFile(wpath.c_str());
+		if ( img && img->GetLastStatus() != Gdiplus::Ok ) { delete img; img = nullptr; }
+		return img;
+	}
+
+
+	std::string trim(const std::string& v)
+	{
+		size_t a = v.find_first_not_of(" \t\r\n"), b = v.find_last_not_of(" \t\r\n");
+		return a == std::string::npos ? std::string() : v.substr(a, b - a + 1);
+	}
+
+	std::string getText(HWND edit)
+	{
+		wchar_t buf[256] = {};
+		GetWindowTextW(edit, buf, 256);
+		char out[512] = {};
+		WideCharToMultiByte(CP_UTF8, 0, buf, -1, out, sizeof(out), nullptr, nullptr);
+		return trim(out);
+	}
+
+	std::map<std::string, std::string> readKeyValues(const std::string& path)
+	{
+		std::map<std::string, std::string> kv;
+		std::ifstream in(path);
+		std::string line;
+		while ( in && std::getline(in, line) )
+		{
+			if ( !line.empty() && line.back() == '\r' ) { line.pop_back(); }
+			size_t eq = line.find('=');
+			if ( eq == std::string::npos || line[0] == '#' ) { continue; }
+			kv[line.substr(0, eq)] = line.substr(eq + 1);
+		}
+		return kv;
+	}
+
+	// Last server, port and name used here; else archipelago.cfg; else archipelago.gg.
+	void fillForm()
+	{
+		std::string host = "archipelago.gg", port, name;
+		auto cfg = readKeyValues(exeDir() + "\\archipelago.cfg");
+		if ( !cfg["server"].empty() )
+		{
+			std::string server = cfg["server"];
+			size_t colon = server.rfind(':');
+			if ( colon != std::string::npos ) { host = server.substr(0, colon); port = server.substr(colon + 1); }
+			else { host = server; }
+		}
+		if ( !cfg["slot"].empty() ) { name = cfg["slot"]; }
+		auto last = readKeyValues(exeDir() + "\\archipelago\\tracker_login.txt");
+		if ( !last["host"].empty() ) { host = last["host"]; }
+		if ( !last["port"].empty() ) { port = last["port"]; }
+		if ( !last["slot"].empty() ) { name = last["slot"]; }
+		if ( !last["room"].empty() ) { host = last["room"]; g_roomLink = host; }
+		g_currentPort = atoi(port.c_str());
+		SetWindowTextW(g_editServer, widen(host).c_str());
+		SetWindowTextW(g_editPort, widen(port).c_str());
+		SetWindowTextW(g_editName, widen(name).c_str());
+	}
+
+	bool gameRunning()
+	{
+		HANDLE m = OpenMutexA(SYNCHRONIZE, FALSE, "BaronyAPGameRunning");
+		if ( !m ) { return false; }
+		CloseHandle(m);
+		return true;
+	}
+
+	// ---- Room links: archipelago.gg/room/<id>. Rooms sleep when idle and wake on a new port, so with
+	// the link we look the port up ourselves (and again whenever the connection is lost).
+
+	bool httpGet(const std::wstring& host, const std::wstring& path, std::string& body)
+	{
+		bool ok = false;
+		HINTERNET session = WinHttpOpen(L"BaronyAPTracker/1.0", WINHTTP_ACCESS_TYPE_AUTOMATIC_PROXY, WINHTTP_NO_PROXY_NAME, WINHTTP_NO_PROXY_BYPASS, 0);
+		if ( !session ) { return false; }
+		WinHttpSetTimeouts(session, 5000, 5000, 8000, 8000);
+		HINTERNET conn = WinHttpConnect(session, host.c_str(), INTERNET_DEFAULT_HTTPS_PORT, 0);
+		HINTERNET req = conn ? WinHttpOpenRequest(conn, L"GET", path.c_str(), nullptr, WINHTTP_NO_REFERER, WINHTTP_DEFAULT_ACCEPT_TYPES, WINHTTP_FLAG_SECURE) : nullptr;
+		if ( req && WinHttpSendRequest(req, WINHTTP_NO_ADDITIONAL_HEADERS, 0, WINHTTP_NO_REQUEST_DATA, 0, 0, 0) && WinHttpReceiveResponse(req, nullptr) )
+		{
+			DWORD avail = 0;
+			while ( WinHttpQueryDataAvailable(req, &avail) && avail > 0 )
+			{
+				std::string chunk(avail, '\0');
+				DWORD got = 0;
+				if ( !WinHttpReadData(req, &chunk[0], avail, &got) ) { break; }
+				body.append(chunk.data(), got);
+				if ( body.size() > 2000000 ) { break; }
+			}
+			ok = true;
+		}
+		if ( req ) { WinHttpCloseHandle(req); }
+		if ( conn ) { WinHttpCloseHandle(conn); }
+		WinHttpCloseHandle(session);
+		return ok;
+	}
+
+	// "https://archipelago.gg/room/AbCd123" -> host "archipelago.gg", id "AbCd123".
+	bool parseRoomLink(const std::string& link, std::string& host, std::string& id)
+	{
+		size_t r = link.find("/room/");
+		if ( r == std::string::npos ) { return false; }
+		std::string front = link.substr(0, r);
+		size_t scheme = front.find("://");
+		host = scheme == std::string::npos ? front : front.substr(scheme + 3);
+		id = link.substr(r + 6);
+		size_t end = id.find_first_of("/?#");
+		if ( end != std::string::npos ) { id = id.substr(0, end); }
+		return !host.empty() && !id.empty();
+	}
+
+	// In a thread: wake the room (opening its page starts it), then ask for its current port.
+	void lookUpRoomPort(std::string link)
+	{
+		if ( g_lookupBusy.exchange(true) ) { return; }
+		g_lastLookup = GetTickCount64();
+		std::thread([link]() {
+			std::string host, id;
+			int port = 0;
+			if ( parseRoomLink(link, host, id) )
+			{
+				std::wstring whost = widen(host);
+				std::string page;
+				httpGet(whost, widen("/room/" + id), page);
+				for ( int attempt = 0; attempt < 4 && port <= 0; ++attempt )
+				{
+					Sleep(attempt == 0 ? 1500 : 3000);
+					std::string json;
+					if ( httpGet(whost, widen("/api/room_status/" + id), json) )
+					{
+						size_t k = json.find("\"last_port\"");
+						if ( k != std::string::npos )
+						{
+							size_t colon = json.find(':', k);
+							if ( colon != std::string::npos ) { port = atoi(json.c_str() + colon + 1); }
+						}
+					}
+				}
+			}
+			g_lookupHost = host;
+			g_lookupBusy = false;
+			PostMessageW(g_main, WM_ROOM_PORT, (WPARAM)std::max(0, port), 0);
+		}).detach();
+	}
+
+	// Writes connect.txt for the game (and starts it, from the launcher).
+	void finishConnect(const std::string& host, const std::string& port, const std::string& name)
+	{
+		std::string dir = exeDir() + "\\archipelago";
+		CreateDirectoryA(dir.c_str(), nullptr);
+		{
+			std::ofstream login(dir + "\\tracker_login.txt", std::ios::trunc);
+			login << "host=" << host << "\nport=" << port << "\nslot=" << name << "\n";
+			if ( !g_roomLink.empty() ) { login << "room=" << g_roomLink << "\n"; }
+		}
+		std::ofstream out(dir + "\\connect.txt", std::ios::trunc);
+		out << "server=" << host << ":" << port << "\nslot=" << name << "\n";
+		out.close();
+		g_currentPort = atoi(port.c_str());
+		g_formNote = L"Connecting...";
+		if ( g_launcher )
+		{
+			// Let the waiting barony.exe start the game; this window becomes the tracker.
+			HANDLE ev = OpenEventA(EVENT_MODIFY_STATE, FALSE, "BaronyAPLaunchConnect");
+			if ( ev ) { SetEvent(ev); CloseHandle(ev); }
+			g_launcher = false;
+			g_gameStartedAt = GetTickCount64();
+			ShowWindow(g_btnPlain, SW_HIDE);
+			InvalidateRect(g_btnConnect, nullptr, TRUE);
+		}
+		InvalidateRect(g_main, nullptr, FALSE);
+	}
+
+	void onRoomPort(int port)
+	{
+		bool automatic = g_pendingAuto;
+		g_pendingAuto = false;
+		if ( port <= 0 )
+		{
+			if ( !automatic ) { g_formNote = L"Couldn't find that room's port. Check the link, or type the port."; }
+			InvalidateRect(g_main, nullptr, FALSE);
+			return;
+		}
+		SetWindowTextW(g_editPort, std::to_wstring(port).c_str());
+		if ( automatic && port == g_currentPort ) { return; } // same port: the game keeps retrying on its own
+		std::string name = g_pendingName.empty() ? getText(g_editName) : g_pendingName;
+		finishConnect(g_lookupHost.empty() ? std::string("archipelago.gg") : g_lookupHost, std::to_string(port), name);
+	}
+
+	void doConnect()
+	{
+		std::string host = getText(g_editServer), port = getText(g_editPort), name = getText(g_editName);
+		if ( host.empty() ) { host = "archipelago.gg"; }
+		bool roomLink = host.find("/room/") != std::string::npos;
+		g_roomLink = roomLink ? host : std::string();
+		if ( !roomLink && host.find(':') != std::string::npos && port.empty() )
+		{
+			port = host.substr(host.rfind(':') + 1);
+			host = host.substr(0, host.rfind(':'));
+		}
+		if ( name.empty() )
+		{
+			g_formNote = L"Type your name (your slot name from your YAML).";
+		}
+		else if ( !g_launcher && !gameRunning() )
+		{
+			g_formNote = L"Start Barony first, then press Connect.";
+		}
+		else if ( roomLink )
+		{
+			g_pendingName = name;
+			g_pendingAuto = false;
+			g_formNote = L"Waking the room and finding its port...";
+			lookUpRoomPort(host);
+		}
+		else if ( port.empty() || port.find_first_not_of("0123456789") != std::string::npos )
+		{
+			g_formNote = L"Type the room's port number (the digits after the colon), or paste the room link.";
+		}
+		else
+		{
+			finishConnect(host, port, name);
+			return;
+		}
+		InvalidateRect(g_main, nullptr, FALSE);
+	}
+
+	// Called every second: if the connection has been lost for a while and we know the room's link,
+	// check whether the room came back on a new port, and reconnect there.
+	void autoReconnect(const std::string& status, int lostFor)
+	{
+		if ( status != "lost" || g_roomLink.empty() || lostFor < 10 || g_lookupBusy ) { return; }
+		if ( GetTickCount64() - g_lastLookup < 30000 ) { return; }
+		g_pendingAuto = true;
+		g_pendingName = getText(g_editName);
+		lookUpRoomPort(g_roomLink);
+	}
+
+	void playPlain()
+	{
+		HANDLE ev = OpenEventA(EVENT_MODIFY_STATE, FALSE, "BaronyAPLaunchPlain");
+		if ( ev ) { SetEvent(ev); CloseHandle(ev); }
+		DestroyWindow(g_main);
+	}
+
+	void showForm(bool show)
+	{
+		if ( show == g_formShown ) { return; }
+		g_formShown = show;
+		int cmd = show ? SW_SHOW : SW_HIDE;
+		ShowWindow(g_editServer, cmd);
+		ShowWindow(g_editPort, cmd);
+		ShowWindow(g_editName, cmd);
+		ShowWindow(g_btnConnect, cmd);
+		ShowWindow(g_btnPlain, show && g_launcher ? SW_SHOW : SW_HIDE);
+		if ( show ) { SetFocus(GetWindowTextLengthW(g_editPort) ? g_editName : g_editPort); }
+		else { SetFocus(g_main); g_formNote.clear(); }
+	}
+
+	void placeForm(int top, int width)
+	{
+		if ( top == g_formTop ) { return; }
+		g_formTop = top;
+		int x = 150, w = width - x - 20, ox = g_sideX;
+		SetWindowPos(g_editServer, nullptr, ox + x, top, w, 34, SWP_NOZORDER);
+		SetWindowPos(g_editPort, nullptr, ox + x, top + 44, 140, 34, SWP_NOZORDER);
+		SetWindowPos(g_editName, nullptr, ox + x, top + 88, w, 34, SWP_NOZORDER);
+		SetWindowPos(g_btnConnect, nullptr, ox + x, top + 136, 210, 42, SWP_NOZORDER);
+		SetWindowPos(g_btnPlain, nullptr, ox + 20, top + 196, width - 40, 42, SWP_NOZORDER);
+	}
+
+	void drawPanel(HDC dc, int x, int y, int w, int h)
+	{
