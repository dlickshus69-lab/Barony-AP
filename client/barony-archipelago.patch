+	void registerSlotInt(const char* key, int SlotOptions::* field)
+	{
+		AP_RegisterSlotDataIntCallback(key, [field](int value) {
+			std::lock_guard<std::mutex> lock(g_netMutex);
+			g_slotIncoming.*field = value;
+			g_slotIncomingReady = true;
