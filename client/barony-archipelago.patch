+					x = r.right + 6;
+				}
+				text(dc, std::max(x + 8, (int)rc.right - 110), y + 4, L"Tab: next", DIM, g_bodyFont);
+				y += 38;
+			}
+			if ( g_tab == 2 )
+			{
+				int have = 0;
+				for ( auto& sp : g_state.spells ) { if ( sp.copies > 0 || sp.fromClass ) { ++have; } }
+				wchar_t buf[128];
+				drawPanel(dc, 10, y - 4, rc.right - 20, 34);
+				text(dc, 20, y, L"Spells you have", GOLD, g_bodyFont);
+				swprintf(buf, 128, L"%d / %d", have, (int)g_state.spells.size());
+				text(dc, rc.right - 110, y, buf, have ? GOOD : DIM, g_bodyFont);
+				y += 40;
+				bool upgrades = num("spellupgrades") > 0, books = num("spellbooks") != 0;
+				const char order[4] = { 'S', 'M', 'T', 'D' };
+				const wchar_t* schoolName[4] = { L"Sorcery", L"Mysticism", L"Thaumaturgy", L"DLC spells" };
+				int colW = (rc.right - 40) / 2;
+				for ( int g = 0; g < 4; ++g )
+				{
+					std::vector<const TrackerState::Spell*> list;
+					for ( auto& sp : g_state.spells ) { if ( sp.school == order[g] ) { list.push_back(&sp); } }
+					if ( list.empty() ) { continue; }
+					int gh = 0;
+					for ( auto* sp : list ) { if ( sp->copies > 0 || sp->fromClass ) { ++gh; } }
+					text(dc, 14, y, schoolName[g], GOLD, g_bodyFont);
+					swprintf(buf, 128, L"%d / %d", gh, (int)list.size());
+					text(dc, rc.right - 90, y, buf, DIM, g_bodyFont);
+					y += 26;
+					for ( size_t i = 0; i < list.size(); ++i )
+					{
+						const auto* sp = list[i];
+						int cx = 20 + (int)(i % 2) * (colW + 4), cy = y + (int)(i / 2) * 22;
+						if ( books && g != 3 )
+						{
+							RECT bk{ cx, cy + 6, cx + 10, cy + 18 };
+							fill(dc, bk, sp->read ? GOLD : RGB(58, 51, 43));
+							cx += 14;
+						}
+						COLORREF c = sp->copies > 0 ? GOOD : sp->fromClass ? STEEL : RGB(111, 106, 98);
+						std::wstring label = widen(sp->name);
+						if ( upgrades && sp->copies > 1 ) { label += L" +" + std::to_wstring(sp->copies - 1); }
+						if ( sp->fromClass ) { label += L" (class)"; }
+						text(dc, cx, cy, label, c, g_bodyFont);
+					}
+					y += (int)((list.size() + 1) / 2) * 22 + 10;
+				}
+				text(dc, 14, y, L"Green: received   Blue: your class   Grey: not yet", DIM, g_bodyFont);
+				y += 22;
+				if ( books ) { text(dc, 14, y, L"Gold square: spellbook read (a check)", DIM, g_bodyFont); y += 22; }
+			}
+			else
+			{
+				const auto& lines = g_tab == 1 ? g_state.log : g_state.items;
+				if ( lines.empty() ) { text(dc, 14, y, L"Nothing yet.", DIM, g_bodyFont); y += 20; }
+				for ( int i = (int)lines.size() - 1; i >= 0; --i, y += 20 ) // newest first
+				{
+					text(dc, 14, y, widen(lines[i]), TEXT, g_bodyFont);
+				}
+			}
+			g_sideContentH = y + 12;
+		}
+
+	}
+
+	void paint(HWND hwnd)
+	{
+		PAINTSTRUCT ps;
+		HDC wdc = BeginPaint(hwnd, &ps);
+		RECT rc;
+		GetClientRect(hwnd, &rc);
+		HDC dc = CreateCompatibleDC(wdc);
+		HBITMAP bmp = CreateCompatibleBitmap(wdc, rc.right, rc.bottom);
+		HGDIOBJ oldBmp = SelectObject(dc, bmp);
+		SetBkMode(dc, TRANSPARENT);
+		fill(dc, rc, BG);
+
+		// Wide window: the floor map on the left, everything else in a column on the right.
+		bool withMap = rc.right >= 900;
+		int sideW = withMap ? 450 : rc.right;
+		int sideX = rc.right - sideW;
+		if ( sideX != g_sideX ) { g_sideX = sideX; g_formTop = -1; }
+		{
+			HDC sdc = CreateCompatibleDC(wdc);
+			// The column is drawn tall and scrolled on its own (mouse wheel over it); the map stays put.
+			int tallH = std::max((int)rc.bottom, (int)3000);
+			HBITMAP sbmp = CreateCompatibleBitmap(wdc, sideW, tallH);
+			HGDIOBJ sold = SelectObject(sdc, sbmp);
+			g_sideContentH = rc.bottom;
+			paintSidebar(sdc, RECT{ 0, 0, sideW, tallH });
+			if ( g_formShown ) { g_sideScroll = 0; } // the connect boxes sit at fixed spots
+			g_sideScroll = std::max(0, std::min(g_sideScroll, std::min(g_sideContentH, tallH) - (int)rc.bottom));
+			BitBlt(dc, sideX, 0, sideW, rc.bottom, sdc, 0, g_sideScroll, SRCCOPY);
+			if ( g_sideContentH > rc.bottom )
+			{
+				// A thin scroll bar on the column's right edge.
+				int track = rc.bottom - 8, thumb = std::max(30, (int)((long long)track * rc.bottom / g_sideContentH));
+				int top = 4 + (int)((long long)(track - thumb) * g_sideScroll / std::max(1, g_sideContentH - (int)rc.bottom));
+				RECT bar{ rc.right - 6, top, rc.right - 2, top + thumb };
+				fill(dc, bar, RGB(110, 95, 75));
+			}
+			SelectObject(sdc, sold);
+			DeleteObject(sbmp);
+			DeleteDC(sdc);
+		}
+		if ( withMap ) { paintMap(dc, RECT{ 10, 10, sideX - 6, rc.bottom - 10 }); }
+		else { g_mapCell = 0; }
+
+		BitBlt(wdc, 0, 0, rc.right, rc.bottom, dc, 0, 0, SRCCOPY);
+		SelectObject(dc, oldBmp);
+		DeleteObject(bmp);
+		DeleteDC(dc);
+		EndPaint(hwnd, &ps);
+	}
+
+	void startZoomedView()
+	{
+		if ( g_viewX < 0 ) { g_viewX = g_map.hasPlayer ? g_map.px : g_map.w / 2.0; g_viewY = g_map.hasPlayer ? g_map.py : g_map.h / 2.0; }
+	}
+	void zoomBy(double f)
+	{
+		if ( g_zoom <= 1.0 && f > 1.0 ) { startZoomedView(); }
+		g_zoom = std::min(8.0, std::max(1.0, g_zoom * f));
+		if ( g_zoom <= 1.0 && !g_follow ) { g_viewX = g_viewY = -1; }
+	}
+	void toggleFollow()
+	{
+		g_follow = !g_follow;
+		if ( g_follow && g_zoom < 2.0 ) { g_zoom = 2.0; }
+	}
+	void fitView() { g_zoom = 1.0; g_follow = false; g_viewX = g_viewY = -1; }
+	void panBy(double dx, double dy)
+	{
+		if ( g_zoom <= 1.0 ) { zoomBy(2.0); }
+		g_follow = false;
+		startZoomedView();
+		g_viewX += dx; g_viewY += dy;
+	}
+
+	LRESULT CALLBACK wndProc(HWND hwnd, UINT msg, WPARAM wp, LPARAM lp)
+	{
+		switch ( msg )
+		{
+			case WM_TIMER:
+				if ( wp == 2 )
+				{
+					// Fast timer: only the moving markers, and only the map is drawn again.
+					if ( readPos() ) { InvalidateRect(hwnd, &g_mapArea, FALSE); }
+					return 0;
+				}
+				readState();
+				readMap();
+				readPos(true); // the full map may be a moment older than the last position
+				if ( gameRunning() && num("connected") == 0 ) { autoReconnect(g_state.values["status"], num("lostfor")); }
+				InvalidateRect(hwnd, nullptr, FALSE);
+				return 0;
+			case WM_KEYDOWN:
+				if ( wp == VK_TAB ) { g_tab = (g_tab + 1) % (g_state.spells.empty() ? 2 : 3); InvalidateRect(hwnd, nullptr, FALSE); }
+				if ( wp == VK_PRIOR || wp == VK_NEXT ) { g_sideScroll += wp == VK_NEXT ? 300 : -300; InvalidateRect(hwnd, nullptr, FALSE); }
+				if ( wp == 'L' || wp == VK_F4 ) { g_lootShort = !g_lootShort; InvalidateRect(hwnd, nullptr, FALSE); }
+				// Map view: F follow, R fit, + / - zoom, arrows move.
+				if ( wp == 'F' ) { toggleFollow(); }
+				else if ( wp == 'R' || wp == VK_HOME ) { fitView(); }
+				else if ( wp == VK_ADD || wp == VK_OEM_PLUS ) { zoomBy(1.25); }
+				else if ( wp == VK_SUBTRACT || wp == VK_OEM_MINUS ) { zoomBy(0.8); }
+				else if ( wp == VK_LEFT ) { panBy(-3, 0); }
+				else if ( wp == VK_RIGHT ) { panBy(3, 0); }
+				else if ( wp == VK_UP ) { panBy(0, -3); }
+				else if ( wp == VK_DOWN ) { panBy(0, 3); }
+				InvalidateRect(hwnd, nullptr, FALSE);
+				return 0;
+			case WM_ROOM_PORT:
+				onRoomPort((int)wp);
+				return 0;
+			case WM_COMMAND:
+				if ( LOWORD(wp) == ID_CONNECT ) { doConnect(); }
+				if ( LOWORD(wp) == ID_PLAIN ) { playPlain(); }
+				return 0;
+			case WM_CTLCOLOREDIT:
+				SetTextColor((HDC)wp, TEXT);
+				SetBkColor((HDC)wp, PANEL);
+				return (LRESULT)g_editBrush;
+			case WM_DRAWITEM:
+			{
+				auto* di = (DRAWITEMSTRUCT*)lp;
+				if ( di->CtlID != ID_CONNECT && di->CtlID != ID_PLAIN ) { break; }
+				bool plain = di->CtlID == ID_PLAIN;
+				bool down = (di->itemState & ODS_SELECTED) != 0;
+				fill(di->hDC, di->rcItem, down ? RGB(90, 70, 30) : RGB(60, 46, 26));
+				HBRUSH border = CreateSolidBrush(plain ? DIM : GOLD);
+				FrameRect(di->hDC, &di->rcItem, border);
+				DeleteObject(border);
+				SetBkMode(di->hDC, TRANSPARENT);
+				SelectObject(di->hDC, g_bodyFont);
+				SetTextColor(di->hDC, plain ? TEXT : GOLD);
+				const wchar_t* label = plain ? L"Play without Archipelago" : g_launcher ? L"Connect & Play" : L"Connect";
+				DrawTextW(di->hDC, label, -1, &di->rcItem, DT_CENTER | DT_VCENTER | DT_SINGLELINE);
+				return TRUE;
+			}
+			case WM_SIZE:
+				g_formTop = -1;
+				InvalidateRect(hwnd, nullptr, FALSE);
+				return 0;
+			case WM_MOUSEWHEEL:
+			{
+				POINT sp{ (short)LOWORD(lp), (short)HIWORD(lp) };
+				ScreenToClient(hwnd, &sp);
+				if ( g_mapCell > 0 && PtInRect(&g_mapArea, sp) )
+				{
+					zoomBy((short)HIWORD(wp) > 0 ? 1.25 : 0.8);
+					InvalidateRect(hwnd, nullptr, FALSE);
+				}
+				else if ( sp.x >= g_sideX )
+				{
+					g_sideScroll -= (short)HIWORD(wp) / WHEEL_DELTA * 60; // over the column: scroll it
+					InvalidateRect(hwnd, nullptr, FALSE);
+				}
+				return 0;
+			}
+			case WM_CAPTURECHANGED:
+				g_dragging = false;
+				return 0;
+			case WM_LBUTTONUP:
+				if ( g_dragging ) { g_dragging = false; ReleaseCapture(); }
+				return 0;
+			case WM_LBUTTONDOWN:
+			{
+				SetFocus(hwnd);
+				{
+					POINT cp{ (short)LOWORD(lp), (short)HIWORD(lp) };
+					if ( g_mapCell > 0 )
+					{
+						if ( PtInRect(&g_btnFollow, cp) ) { toggleFollow(); InvalidateRect(hwnd, nullptr, FALSE); return 0; }
+						if ( PtInRect(&g_btnFit, cp) ) { fitView(); InvalidateRect(hwnd, nullptr, FALSE); return 0; }
+						if ( PtInRect(&g_btnIn, cp) ) { zoomBy(1.25); InvalidateRect(hwnd, nullptr, FALSE); return 0; }
+						if ( PtInRect(&g_btnOut, cp) ) { zoomBy(0.8); InvalidateRect(hwnd, nullptr, FALSE); return 0; }
+						if ( PtInRect(&g_mapArea, cp) && (g_zoom > 1.0 || g_follow) )
+						{
+							// Drag to move the zoomed-in map.
+							startZoomedView();
+							g_follow = false;
+							g_dragging = true;
+							g_dragX = cp.x; g_dragY = cp.y;
+							g_dragViewX = g_viewX; g_dragViewY = g_viewY;
+							SetCapture(hwnd);
+							InvalidateRect(hwnd, nullptr, FALSE);
+							return 0;
+						}
+					}
+				}
+				POINT pt{ (short)LOWORD(lp) - g_sideX, (short)HIWORD(lp) + g_sideScroll };
+				for ( int t = 0; t < 3; ++t )
+				{
+					if ( PtInRect(&g_tabRects[t], pt) ) { g_tab = t; InvalidateRect(hwnd, nullptr, FALSE); return 0; }
+				}
+				if ( PtInRect(&g_lootBox, pt) ) { g_lootShort = !g_lootShort; InvalidateRect(hwnd, nullptr, FALSE); }
+				return 0;
+			}
+			case WM_MOUSEMOVE:
+			{
+				int mx = (short)LOWORD(lp), my = (short)HIWORD(lp);
+				if ( g_dragging && g_mapCell > 0 )
+				{
+					g_viewX = g_dragViewX - (double)(mx - g_dragX) / g_mapCell;
+					g_viewY = g_dragViewY - (double)(my - g_dragY) / g_mapCell;
+					InvalidateRect(hwnd, nullptr, FALSE);
+					return 0;
+				}
+				int tx = -1, ty = -1;
+				POINT mp{ mx, my };
+				if ( g_mapCell > 0 && PtInRect(&g_mapArea, mp) && mx >= g_mapX && my >= g_mapY )
+				{
+					tx = (mx - g_mapX) / g_mapCell;
+					ty = (my - g_mapY) / g_mapCell;
+					if ( tx >= g_map.w || ty >= g_map.h ) { tx = ty = -1; }
+				}
+				if ( tx != g_hoverX || ty != g_hoverY || mx != g_mouseX || my != g_mouseY )
+				{
+					bool redraw = tx != g_hoverX || ty != g_hoverY || pileAt(tx, ty) != nullptr;
+					g_hoverX = tx; g_hoverY = ty; g_mouseX = mx; g_mouseY = my;
+					if ( redraw ) { InvalidateRect(hwnd, nullptr, FALSE); }
+				}
+				return 0;
+			}
+			case WM_ERASEBKGND:
+				return 1;
+			case WM_PAINT:
+				paint(hwnd);
+				return 0;
+			case WM_DESTROY:
+				PostQuitMessage(0);
+				return 0;
+		}
+		return DefWindowProcW(hwnd, msg, wp, lp);
+	}
+}
+
+int WINAPI WinMain(HINSTANCE inst, HINSTANCE, LPSTR, int show)
+{
+	g_launcher = strstr(GetCommandLineA(), "--launcher") != nullptr;
+	// Only one tracker at a time. The launcher replaces an old tracker window that's still open.
+	HANDLE mutex = CreateMutexA(nullptr, TRUE, "BaronyAPTrackerSingleInstance");
+	if ( GetLastError() == ERROR_ALREADY_EXISTS )
+	{
+		if ( !g_launcher ) { return 0; }
+		if ( HWND old = FindWindowW(L"BaronyAPTracker", nullptr) ) { PostMessageW(old, WM_CLOSE, 0, 0); }
+		WaitForSingleObject(mutex, 3000);
+	}
+
+	Gdiplus::GdiplusStartupInput gdiplusInput;
+	ULONG_PTR gdiplusToken = 0;
+	Gdiplus::GdiplusStartup(&gdiplusToken, &gdiplusInput, nullptr);
+	// Barony's title with the Archipelago logo (the game makes it at startup), else Barony's own.
+	g_logo = loadImage("images\\ui\\Archipelago\\AP_Title.png");
+	if ( !g_logo ) { g_logo = loadImage("images\\system\\title.png"); }
+
+	// Barony's own UI font (Pixel Maz), from the game's fonts folder; Consolas if it can't be loaded.
+	std::string fontPath = exeDir() + "\\fonts\\pixel_maz.ttf";
+	if ( AddFontResourceExA(fontPath.c_str(), FR_PRIVATE, nullptr) > 0 )
+	{
+		g_titleFont = CreateFontW(-44, 0, 0, 0, FW_NORMAL, 0, 0, 0, DEFAULT_CHARSET, 0, 0, NONANTIALIASED_QUALITY, 0, L"Pixel Maz");
+		g_bodyFont = CreateFontW(-32, 0, 0, 0, FW_NORMAL, 0, 0, 0, DEFAULT_CHARSET, 0, 0, NONANTIALIASED_QUALITY, 0, L"Pixel Maz");
+	}
+	else
+	{
+		g_titleFont = CreateFontW(26, 0, 0, 0, FW_BOLD, 0, 0, 0, DEFAULT_CHARSET, 0, 0, NONANTIALIASED_QUALITY, 0, L"Consolas");
+		g_bodyFont = CreateFontW(17, 0, 0, 0, FW_NORMAL, 0, 0, 0, DEFAULT_CHARSET, 0, 0, CLEARTYPE_QUALITY, 0, L"Consolas");
+	}
+
+	WNDCLASSW wc{};
+	wc.lpfnWndProc = wndProc;
+	wc.hInstance = inst;
+	wc.hCursor = LoadCursor(nullptr, IDC_ARROW);
+	wc.lpszClassName = L"BaronyAPTracker";
+	wc.hIcon = LoadIcon(nullptr, IDI_APPLICATION);
+	RegisterClassW(&wc);
+
+	HWND hwnd = CreateWindowExW(0, wc.lpszClassName, L"Barony Archipelago Tracker",
+		WS_OVERLAPPEDWINDOW | WS_CLIPCHILDREN, CW_USEDEFAULT, CW_USEDEFAULT, 1300, 900, nullptr, nullptr, inst, nullptr);
+	g_main = hwnd;
+	g_editBrush = CreateSolidBrush(PANEL);
+	auto makeEdit = [&](DWORD extra) {
+		HWND e = CreateWindowExW(0, L"EDIT", L"", WS_CHILD | WS_BORDER | ES_AUTOHSCROLL | extra,
+			0, 0, 10, 10, hwnd, nullptr, inst, nullptr);
+		SendMessageW(e, WM_SETFONT, (WPARAM)g_bodyFont, TRUE);
+		return e;
+	};
+	g_editServer = makeEdit(0);
+	g_editPort = makeEdit(ES_NUMBER);
+	g_editName = makeEdit(0);
+	g_btnConnect = CreateWindowExW(0, L"BUTTON", L"Connect", WS_CHILD | BS_OWNERDRAW,
+		0, 0, 10, 10, hwnd, (HMENU)(INT_PTR)ID_CONNECT, inst, nullptr);
+	g_btnPlain = CreateWindowExW(0, L"BUTTON", L"Play without Archipelago", WS_CHILD | BS_OWNERDRAW,
+		0, 0, 10, 10, hwnd, (HMENU)(INT_PTR)ID_PLAIN, inst, nullptr);
+	fillForm();
+	ShowWindow(hwnd, show);
+	SetTimer(hwnd, 1, 1000, nullptr);
+	SetTimer(hwnd, 2, 100, nullptr); // your position on the map, 10 times a second
+	readState();
+	readMap();
+
+	MSG m;
+	while ( GetMessageW(&m, nullptr, 0, 0) )
+	{
+		// In the connect form: Enter connects, Tab moves to the next box.
+		if ( m.message == WM_KEYDOWN && (m.hwnd == g_editServer || m.hwnd == g_editPort || m.hwnd == g_editName) )
+		{
+			if ( m.wParam == VK_RETURN ) { doConnect(); continue; }
+			if ( m.wParam == VK_TAB )
+			{
+				bool back = GetKeyState(VK_SHIFT) < 0;
+				HWND order[] = { g_editServer, g_editPort, g_editName };
+				int i = m.hwnd == g_editServer ? 0 : m.hwnd == g_editPort ? 1 : 2;
+				SetFocus(order[(i + (back ? 2 : 1)) % 3]);
+				SendMessageW(GetFocus(), EM_SETSEL, 0, -1);
+				continue;
+			}
+		}
+		if ( m.message == WM_CHAR && (m.wParam == '\r' || m.wParam == '\t')
+			&& (m.hwnd == g_editServer || m.hwnd == g_editPort || m.hwnd == g_editName) ) { continue; } // no beep
+		TranslateMessage(&m);
+		DispatchMessageW(&m);
+	}
+	delete g_logo;
+	if ( g_editBrush ) { DeleteObject(g_editBrush); }
+	Gdiplus::GdiplusShutdown(gdiplusToken);
+	if ( mutex ) { CloseHandle(mutex); }
+	return 0;
+}
