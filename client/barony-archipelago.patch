+		Gdiplus::SolidBrush b(Gdiplus::Color(200, 30, 24, 18));
+		g.FillRectangle(&b, x, y, w, h);
+		Gdiplus::Pen pen(Gdiplus::Color(255, 74, 62, 48), 1.0f);
