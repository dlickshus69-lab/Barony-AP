+			if ( msg && (msg->type == AP_MessageType::ItemSend || msg->type == AP_MessageType::Hint
+				|| msg->type == AP_MessageType::Chat || msg->type == AP_MessageType::ServerChat
+				|| msg->type == AP_MessageType::Countdown) )
