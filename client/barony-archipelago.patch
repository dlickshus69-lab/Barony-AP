+		char buf[512];
+		va_list args;
+		va_start(args, fmt);
+		vsnprintf(buf, sizeof(buf), fmt, args);
+		va_end(args);
+		messagePlayerColor(clientnum, MESSAGE_HINT, color, "%s", buf);
+		printlog("[Archipelago] %s", buf);
+		addLog(buf, color);
+	}
